# OpenAI — required for all AI features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The model for web searches (the crime scan's research, and the forecast's market check when
# FORECAST_WEB_SEARCH=on). It must support limiting a search to given sites. Empty = OPENAI_MODEL.
OPENAI_RESEARCH_MODEL=

# Gemini — optional fallback for web-search calls (research step)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_SEARCH_MODEL=

# MongoDB — optional cloud backup (manual sync from the menu)
MONGODB_URI=

FORECAST_WEB_SEARCH=on

# Web app: signs the cookie that carries messages between pages. Make one with
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep it private. Empty = a new random key at every start (fine on your own computer).
SECRET_KEY=
