_pieces(saved : dict) : dict[str, str]&lt;br&gt;− __assess(case : dict, files : list[dict] | None,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;documents : list[dict], saved : dict, on_step : Callable[[int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;str], None] | None, on_failure : Callable[[str, str],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;bool] | None) : dict | None&lt;/div&gt;" vertex="1">
