                <mxCell id="c24" parent="1" style="text;html=1;fontSize=14;fontColor=#64748B;align=left;verticalAlign=middle;whiteSpace=wrap;" value="+ public &amp;nbsp; # protected (_name) &amp;nbsp; − private (__name) &amp;nbsp; {get} = read-only &amp;nbsp; {get, set} = property with a checking setter &amp;nbsp; «property» = computed value" vertex="1">
                    <mxGeometry height="46" width="1225" x="30" y="476" as="geometry"/>
